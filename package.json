{
	"name": "@shadcn-docs-nuxt-production-repro/root",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.14.0 <23"
	},
	"scripts": {
		"build": "turbo run build --concurrency=1",
		"build:fresh": "turbo run build --concurrency=1 --force",
		"build:docs": "pnpm --filter @repro/docs build",
		"build:api": "pnpm --filter @repro/api build",
		"build:packages": "pnpm --filter @repro/shared-core build && pnpm --filter @repro/ui build",
		"dev:docs": "pnpm --filter @repro/docs dev",
		"dev:api": "pnpm --filter @repro/api dev",
		"prepare:docs": "pnpm --filter @repro/docs prepare",
		"typecheck": "turbo run typecheck --concurrency=1",
		"test": "pnpm test:contracts && pnpm test:packages",
		"test:contracts": "node --test tests/*.test.mjs",
		"test:packages": "turbo run test --concurrency=1",
		"probe:deps": "tsx probes/dependency-tree.ts",
		"probe:h3": "tsx probes/resolve-h3.ts",
		"probe:ui": "tsx probes/resolve-workspace-ui.ts",
		"probe:content": "tsx probes/content-smoke.ts",
		"probe:closure": "tsx probes/inspect-artifact-closure.ts",
		"probe:artifact": "tsx probes/artifact-smoke.ts",
		"probe:all": "pnpm probe:deps && pnpm probe:h3 && pnpm probe:ui",
		"format": "prettier --experimental-cli --write --no-parallel .",
		"prepare": "simple-git-hooks",
		"clean": "rimraf apps/**/.nuxt apps/**/.output apps/**/.vercel packages/**/dist packages/**/node_modules/.cache .turbo"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.2.3",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-lint-md": "1.0.1",
		"rimraf": "6.1.3",
		"simple-git-hooks": "^2.14.0",
		"tsx": "4.21.0",
		"turbo": "2.9.3",
		"typescript": "5.9.3",
		"wrangler": "4.146.0"
	},
	"pnpm": {
		"overrides": {
			"@ztl-uwu/nuxt-content": "2.14.1",
			"nitropack": "2.13.5",
			"nuxt-og-image": "5.1.9"
		}
	}
}
