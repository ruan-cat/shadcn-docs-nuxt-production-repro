{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // 2026-10-17 init-tsconfig 技能落地（形态 D monorepo 子包）：增量缓存消除 vue-tsc/tsserver 全量重复编译内存峰值。
    // 缓存写本包 node_modules/.cache（已被 .gitignore 覆盖），与 shared-core 包各目录独立，无共享写冲突。
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    // 仅 monorepo 子包生效：变更只重查直接依赖
    "assumeChangesOnlyAffectDirectDependencies": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
